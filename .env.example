# Gmail credentials for sending certificates via SMTP.
#
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Paste the 16-character password below (with spaces is fine)
#
# These are the only credentials required to send emails.

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Timezone for every time shown or exported. IANA name.
APP_TIMEZONE=Asia/Kolkata
# The web UI formats times with NEXT_PUBLIC_APP_TIMEZONE (set it to the same value; defaults to Asia/Kolkata).
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Sending limits (all optional)
# Seconds between emails. Keeps a big run from tripping Gmail's rate checks.
SEND_INTERVAL_SECONDS=1.0
# Stop before Gmail's own cap (about 500 per rolling 24h on a personal account).
SEND_DAILY_CAP=450
# Retries for dropped connections and 4xx replies, with doubling backoff.
SEND_MAX_RETRIES=3
SEND_BACKOFF_BASE_SECONDS=2.0
